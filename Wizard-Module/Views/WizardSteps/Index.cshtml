@model Wizard.Module.ViewModels.WizardStepListViewModel
@*
    Wizard Yönetimi. Turun içeriği buradan girilir.

    Tablo sunucuda üretiliyor: tablo eklentisi, modal pencere ve host'un
    JavaScript dosyaları kullanılmıyor. Modül taşındığı sistemde bunların
    hangisinin bulunacağını varsayamaz.

    Arama ve sayfalama da sunucuda. Formlar düz GET, sayfa bağlantıları düz
    bağlantı — bu ekranda hiç JavaScript çalışmıyor.

    Silme, satır içindeki küçük bir POST formu. Formu Razor ürettiği için
    sahtecilik jetonu (antiforgery) kendiliğinden ekleniyor.
*@

@if (TempData["WizardMesaj"] != null)
{
    <div class="alert alert-info">@TempData["WizardMesaj"]</div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Wizard Adımları</h3>
        <div class="card-tools">
            <a asp-action="Add" data-wizard-id="wizard-step-add" class="btn btn-success btn-sm">Yeni Adım Ekle</a>
        </div>
    </div>

    <div class="card-body">
        @* Arama GET ile gönderiliyor: sonuç adrese yazıldığı için sayfa
           yer imine eklenebiliyor ve yenilendiğinde kaybolmuyor. *@
        <form asp-action="Index" method="get" class="form-inline mb-3">
            <input type="text" name="ara" value="@Model.Search" class="form-control mr-2"
                   data-wizard-id="wizard-step-search" placeholder="Başlık, modül, sıra, seçici, yetki..." />
            <button type="submit" class="btn btn-default mr-2">Ara</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-action="Index" class="btn btn-link">Aramayı temizle</a>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Modül</th>
                        <th>Başlık</th>
                        <th>Hedef</th>
                        <th>Sayfa</th>
                        <th>Yetki</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var step in Model.Steps)
                {
                    <tr>
                        @* Razor bütün değerleri kaçışlayarak basar; adım metinleri
                           serbestçe girildiği için bu şart. *@
                        <td>@step.SortPath</td>
                        <td>@step.ModuleName</td>
                        <td>@step.Title</td>
                        <td><code>@step.TargetSelector</code></td>
                        <td>@(string.IsNullOrWhiteSpace(step.TargetUrl) ? "(bulunduğu sayfa)" : step.TargetUrl)</td>
                        <td>@(string.IsNullOrWhiteSpace(step.RequiredPermission) ? "(herkese açık)" : step.RequiredPermission)</td>
                        <td class="text-right">
                            <a asp-action="Edit" asp-route-id="@step.Id" data-wizard-id="record-edit" class="btn btn-primary btn-sm">Düzenle</a>

                            <form asp-action="Delete" asp-route-id="@step.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu adımı silmek istediğinize emin misiniz?');">
                                <button type="submit" data-wizard-id="record-delete" class="btn btn-danger btn-sm">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.TotalCount == 0)
        {
            <p class="text-muted mb-0">
                @(string.IsNullOrWhiteSpace(Model.Search)
                    ? "Henüz adım eklenmemiş. Tur, adım olmadan hiç açılmaz."
                    : "Aramanıza uyan adım bulunamadı.")
            </p>
        }
    </div>

    @if (Model.PageCount > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="text-muted">@Model.TotalCount kayıttan @Model.Page / @Model.PageCount. sayfa</span>

            @* Arama metni sayfa bağlantılarında taşınıyor, yoksa ikinci sayfada
               filtre kaybolurdu. *@
            <span>
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-ara="@Model.Search" asp-route-sayfa="@(Model.Page - 1)" class="btn btn-default btn-sm">Önceki</a>
                }
                @if (Model.Page < Model.PageCount)
                {
                    <a asp-action="Index" asp-route-ara="@Model.Search" asp-route-sayfa="@(Model.Page + 1)" class="btn btn-default btn-sm">Sonraki</a>
                }
            </span>
        </div>
    }
</div>
